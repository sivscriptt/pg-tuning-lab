# Lab layout. Override any value from the environment.
PGBIN="${PGBIN:-$HOME/.local/src/pg17/pgsql/bin}"
LAB_DIR="${LAB_DIR:-$HOME/.pg-tuning-lab}"   # cluster data lives outside the repo
PORT="${PORT:-55440}"
CUSTOMERS="${CUSTOMERS:-500000}"
ACCOUNTS="${ACCOUNTS:-1000000}"
TXNS="${TXNS:-10000000}"                     # spread over 24 months
SHARED_BUFFERS="${SHARED_BUFFERS:-512MB}"    # sized for an 8 GB laptop
